{
    "repoid": "Qing-Agent",
    "branch": "main",
    "version": "0.1.2",
    "model_args": {
        "model_path": "./model/Qwen2.5-7B-Instruct",
        "model_repo": "Qwen/Qwen2.5-7B-Instruct",
        "models_dir": "./model",
        "model_output_path": "./model_output",
        "template": "qwen",
        "finetuning_type": "qlora",
        "trust_remote_code": true,
        "download_source": "modelscope"
    },
    "logger_args": {
        "log_level": "INFO",
        "language": "zhcn"
    },
    "data_args": {
        "paths": {
            "data_root": "./data",
            "runs_root": "./runs"
        },
        "data_dir": "./data/chat/qq/original/",
        "output_dir": null,  // 留空则由 CLI 自动输出到 runs/chat/<run_id>/csv
        "media_dir": "./data/chat/media",
        "qq_agrs": {
            "qq_c2c_db_path": "./data/chat/qq/original/qq.db",
            "qq_group_db_path": null,  // 可填.db或导出的.sql（group_msg_table）
            "qq_group_focus_ai": true,  // 仅保留AI消息及其上下文，避免群聊刷屏数据
            "qq_group_context_before": 6,  // AI发言前保留的消息条数
            "qq_group_context_after": 2,  // AI发言后保留的消息条数
            "qq_number_ai": "1234567890"
        },
        "telegram_args": {
            "telegram_chat_id": null,
            "tg_data_dir": "./data/chat/telegram/original/"
        },
        "include_type": [
            "text"
        ],
        "blocked_words": [
            "密码",
            "账号",
            "手机号"
        ],
        "single_combine_time_window": 2,
        "qa_match_time_window": 5,
        "combine_msg_max_length": 2048,
        "messages_max_length": 2048,
        "max_image_num": 2,
        "add_time_to_system": false,
        "vision_api": {  // 目前不支持vision,请勿开启
            "enable": false,
            "api_base": "",
            "api_key": "",
            "model_name": "",
            "max_workers": 4
        },
        "clean_set_args": {
            "clean_method": "llm",
            "llm_parser": "default",
            "openai_api": {
                "api_base": "http://127.0.0.1:1236/v1/chat/completions",
                "api_key": "sk-1234567890abcdef1234567890abcdef",
                "model_name": "qwen3-8b-fp6",
                "thinking": "none",  // 可选: enable, disable, none
                "service_tier": "default",  //或改为flex或batch享受一些平台的优惠
                "temperature": 1.0,
                "clean_batch_size": 10,
                "clean_workers": 4,
                "timeout": 20
            }
        },
        "train_sft_args": {
            "use_qlora": true,
            "data_path": "LATEST",  // 由配置生成器自动解析到 runs/chat/<latest>/sft/train.jsonl；也可手动填具体路径以复现实验
            "lora_r": 16,
            "lora_alpha": 32,
            "lora_dropout": 0.1,
            "lora_target_modules": [
                "q_proj",
                "v_proj"
            ],
            "per_device_train_batch_size": 1,
            "per_device_eval_batch_size": 1,
            "gradient_accumulation_steps": 16,
            "max_steps": -1,
            "learning_rate": 0.0002,
            "fp16": true,
            "logging_steps": 10,
            "save_steps": 100,
            "load_precision": "int4",
            "max_workers": 6,
            "use_unsloth": true
        },
        "openai_sft_system_prompt": "*",  // OpenAI 导出SFT专用system prompt；"*"或空串表示不添加；填字符串则注入到每条样本开头
        "system_prompt": "*"
    }
}
